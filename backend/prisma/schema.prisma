// Prisma schema for Social Media Activity Verification Portal
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Platform {
  INSTAGRAM
  LINKEDIN
  FACEBOOK
}

enum ActionType {
  LIKE
  COMMENT
  STORY
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  SUBMISSION_UPDATE
  REVIEW_FEEDBACK
  ACCOUNT_ALERT
  SYSTEM
}

enum PointActionType {
  LIKE
  COMMENT
  STORY
  BONUS
  ADJUSTMENT
}

// ============================================================================
// Models
// ============================================================================

/// User entity with role-based access control (SUPER_ADMIN, ADMIN, USER)
model User {
  id                String           @id @default(uuid())
  name              String
  email             String           @unique
  password          String
  role              Role             @default(USER)
  status            UserStatus       @default(ACTIVE)
  totalPoints       Int              @default(0)
  totalXP           Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relationships
  socialAccounts    SocialAccount[]
  submissions       Submission[]     @relation("UserSubmissions")
  reviews           Review[]         @relation("AdminReviews")
  notifications     Notification[]   @relation("UserNotifications")
  internalNotes     ReviewNote[]     @relation("AdminNotes")
  clarifications    ClarificationRequest[] @relation("AdminClarifications")
  pointTransactions PointTransaction[] @relation("UserPointTransactions")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([name])
  @@index([role, status])
  @@index([createdAt])
  @@index([totalPoints(sort: Desc)])
  @@index([totalXP(sort: Desc)])
  @@index([role, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("users")
}

/// Official Social Media Accounts managed by Super Admin
model SocialAccount {
  id          String        @id @default(uuid())
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    Platform
  handle      String
  name        String?
  accountUrl  String?
  profileUrl  String?
  description String?
  isActive    Boolean       @default(true)
  isVerified  Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relationships
  submissions Submission[]

  @@index([userId])
  @@index([platform])
  @@index([isActive])
  @@index([platform, isActive])
  @@index([handle])
  @@index([name])
  @@index([createdAt(sort: Desc)])
  @@index([platform, createdAt(sort: Desc)])
  @@index([isActive, createdAt(sort: Desc)])
  @@map("social_accounts")
}

/// Activity Submissions created by Users and linked to an official SocialAccount
model Submission {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation("UserSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  socialAccountId String?
  socialAccount   SocialAccount?    @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  platform        Platform
  actionType      ActionType
  postUrl         String
  screenshotUrl   String?
  description     String?
  status          SubmissionStatus  @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relationships
  reviews         Review[]
  internalNotes   ReviewNote[]            @relation("SubmissionNotes")
  clarifications  ClarificationRequest[]  @relation("SubmissionClarifications")
  pointTransactions PointTransaction[]   @relation("SubmissionPointTransactions")

  @@index([userId])
  @@index([socialAccountId])
  @@index([platform, actionType])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([platform, status])
  @@index([actionType])
  @@index([platform, createdAt(sort: Desc)])
  @@index([actionType, createdAt(sort: Desc)])
  @@index([platform, status, createdAt(sort: Desc)])
  @@index([actionType, status, createdAt(sort: Desc)])
  @@map("submissions")
}

/// Moderation Reviews performed by Admins on Submissions
model Review {
  id            String            @id @default(uuid())
  submissionId  String
  submission    Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  adminId       String
  admin         User              @relation("AdminReviews", fields: [adminId], references: [id], onDelete: Restrict)
  status        SubmissionStatus
  feedback      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([submissionId])
  @@index([adminId])
  @@index([status])
  @@index([createdAt])
  @@index([adminId, createdAt(sort: Desc)])
  @@index([submissionId, createdAt(sort: Desc)])
  @@map("reviews")
}

/// Internal moderation notes attached by Admins for team auditability
model ReviewNote {
  id           String      @id @default(uuid())
  submissionId String
  submission   Submission  @relation("SubmissionNotes", fields: [submissionId], references: [id], onDelete: Cascade)
  adminId      String
  admin        User        @relation("AdminNotes", fields: [adminId], references: [id], onDelete: Cascade)
  note         String
  createdAt    DateTime    @default(now())

  @@index([submissionId])
  @@index([adminId])
  @@map("review_notes")
}

/// Formal clarification requests sent by Admins to Creators
model ClarificationRequest {
  id           String      @id @default(uuid())
  submissionId String
  submission   Submission  @relation("SubmissionClarifications", fields: [submissionId], references: [id], onDelete: Cascade)
  adminId      String
  admin        User        @relation("AdminClarifications", fields: [adminId], references: [id], onDelete: Cascade)
  message      String
  response     String?
  status       String      @default("PENDING")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([submissionId])
  @@index([adminId])
  @@map("clarification_requests")
}

/// User Notifications for submission updates, moderation alerts, and system info
model Notification {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType  @default(SYSTEM)
  title       String
  message     String
  isRead      Boolean           @default(false)
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type])
  @@index([type])
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Gamification Point and XP Transactions awarded for approved submissions and adjustments
model PointTransaction {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation("UserPointTransactions", fields: [userId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission?     @relation("SubmissionPointTransactions", fields: [submissionId], references: [id], onDelete: SetNull)
  points       Int             @default(0)
  xp           Int             @default(0)
  actionType   PointActionType
  description  String
  metadata     Json?
  createdAt    DateTime        @default(now())

  @@index([userId])
  @@index([submissionId])
  @@index([actionType])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([actionType, createdAt(sort: Desc)])
  @@map("point_transactions")
}

/// Dynamic Gamification Level configuration managed by Super Admin
model Level {
  id          String   @id @default(uuid())
  levelNumber Int      @unique
  name        String
  xpRequired  Int      @default(250)
  icon        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([levelNumber])
  @@index([isActive])
  @@map("levels")
}

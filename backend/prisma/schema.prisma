// Prisma schema for Social Media Activity Verification Portal
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Platform {
  INSTAGRAM
  LINKEDIN
  FACEBOOK
}

enum ActionType {
  LIKE
  COMMENT
  STORY
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  SUBMISSION_UPDATE
  REVIEW_FEEDBACK
  ACCOUNT_ALERT
  SYSTEM
}

// ============================================================================
// Models
// ============================================================================

/// User entity with role-based access control (SUPER_ADMIN, ADMIN, USER)
model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  password        String
  role            Role             @default(USER)
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relationships
  socialAccounts  SocialAccount[]
  submissions     Submission[]     @relation("UserSubmissions")
  reviews         Review[]         @relation("AdminReviews")
  notifications   Notification[]   @relation("UserNotifications")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

/// Official Social Media Accounts linked to a User
model SocialAccount {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    Platform
  handle      String
  profileUrl  String?
  isVerified  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relationships
  submissions Submission[]

  @@unique([userId, platform, handle])
  @@index([userId])
  @@index([platform])
  @@map("social_accounts")
}

/// Activity Submissions created by Users and linked to an official SocialAccount
model Submission {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation("UserSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  socialAccountId String?
  socialAccount   SocialAccount?    @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  platform        Platform
  actionType      ActionType
  postUrl         String
  screenshotUrl   String?
  description     String?
  status          SubmissionStatus  @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relationships
  reviews         Review[]

  @@index([userId])
  @@index([socialAccountId])
  @@index([platform, actionType])
  @@index([status])
  @@index([createdAt])
  @@map("submissions")
}

/// Moderation Reviews performed by Admins on Submissions
model Review {
  id            String            @id @default(uuid())
  submissionId  String
  submission    Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  adminId       String
  admin         User              @relation("AdminReviews", fields: [adminId], references: [id], onDelete: Restrict)
  status        SubmissionStatus
  feedback      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([submissionId])
  @@index([adminId])
  @@index([status])
  @@index([createdAt])
  @@map("reviews")
}

/// User Notifications for submission updates, moderation alerts, and system info
model Notification {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType  @default(SYSTEM)
  title       String
  message     String
  isRead      Boolean           @default(false)
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

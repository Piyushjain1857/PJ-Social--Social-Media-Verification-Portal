// Prisma schema for Social Media Activity Verification Portal
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Platform {
  INSTAGRAM
  LINKEDIN
  FACEBOOK
}

enum ActionType {
  LIKE
  COMMENT
  STORY
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  SUBMISSION_UPDATE
  REVIEW_FEEDBACK
  ACCOUNT_ALERT
  SYSTEM
}

enum PointActionType {
  LIKE
  COMMENT
  STORY
  BONUS
  ADJUSTMENT
  ADMIN_ADJUSTMENT
  SUPER_ADMIN_ADJUSTMENT
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// ============================================================================
// Models
// ============================================================================

/// User entity with role-based access control (SUPER_ADMIN, ADMIN, USER)
model User {
  id                String           @id @default(uuid())
  name              String
  email             String           @unique
  password          String
  role              Role             @default(USER)
  status            UserStatus       @default(ACTIVE)
  totalPoints       Int              @default(0)
  totalXP           Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relationships
  socialAccounts    SocialAccount[]
  submissions       Submission[]     @relation("UserSubmissions")
  reviews           Review[]         @relation("AdminReviews")
  notifications     Notification[]   @relation("UserNotifications")
  internalNotes     ReviewNote[]     @relation("AdminNotes")
  clarifications    ClarificationRequest[] @relation("AdminClarifications")
  pointTransactions PointTransaction[] @relation("UserPointTransactions")
  emailPreference   EmailPreference?

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([name])
  @@index([role, status])
  @@index([role, status, totalXP(sort: Desc)])
  @@index([createdAt])
  @@index([totalPoints(sort: Desc)])
  @@index([totalXP(sort: Desc)])
  @@index([role, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("users")
}

/// Official Social Media Accounts managed by Super Admin
model SocialAccount {
  id          String        @id @default(uuid())
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    Platform
  handle      String
  name        String?
  accountUrl  String?
  profileUrl  String?
  description String?
  isActive    Boolean       @default(true)
  isVerified  Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relationships
  submissions Submission[]

  @@index([userId])
  @@index([platform])
  @@index([isActive])
  @@index([platform, isActive])
  @@index([handle])
  @@index([name])
  @@index([createdAt(sort: Desc)])
  @@index([platform, createdAt(sort: Desc)])
  @@index([isActive, createdAt(sort: Desc)])
  @@map("social_accounts")
}

/// Activity Submissions created by Users and linked to an official SocialAccount
model Submission {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation("UserSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  socialAccountId String?
  socialAccount   SocialAccount?    @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  platform        Platform
  actionType      ActionType
  postUrl         String
  screenshotUrl   String?
  description     String?
  status          SubmissionStatus  @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relationships
  reviews         Review[]
  internalNotes   ReviewNote[]            @relation("SubmissionNotes")
  clarifications  ClarificationRequest[]  @relation("SubmissionClarifications")
  pointTransactions PointTransaction[]   @relation("SubmissionPointTransactions")

  @@index([userId])
  @@index([socialAccountId])
  @@index([platform, actionType])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([platform, status])
  @@index([actionType])
  @@index([platform, createdAt(sort: Desc)])
  @@index([actionType, createdAt(sort: Desc)])
  @@index([platform, status, createdAt(sort: Desc)])
  @@index([actionType, status, createdAt(sort: Desc)])
  @@map("submissions")
}

/// Moderation Reviews performed by Admins on Submissions
model Review {
  id            String            @id @default(uuid())
  submissionId  String
  submission    Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  adminId       String
  admin         User              @relation("AdminReviews", fields: [adminId], references: [id], onDelete: Restrict)
  status        SubmissionStatus
  feedback      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([submissionId])
  @@index([adminId])
  @@index([status])
  @@index([createdAt])
  @@index([adminId, createdAt(sort: Desc)])
  @@index([submissionId, createdAt(sort: Desc)])
  @@map("reviews")
}

/// Internal moderation notes attached by Admins for team auditability
model ReviewNote {
  id           String      @id @default(uuid())
  submissionId String
  submission   Submission  @relation("SubmissionNotes", fields: [submissionId], references: [id], onDelete: Cascade)
  adminId      String
  admin        User        @relation("AdminNotes", fields: [adminId], references: [id], onDelete: Cascade)
  note         String
  createdAt    DateTime    @default(now())

  @@index([submissionId])
  @@index([adminId])
  @@map("review_notes")
}

/// Formal clarification requests sent by Admins to Creators
model ClarificationRequest {
  id           String      @id @default(uuid())
  submissionId String
  submission   Submission  @relation("SubmissionClarifications", fields: [submissionId], references: [id], onDelete: Cascade)
  adminId      String
  admin        User        @relation("AdminClarifications", fields: [adminId], references: [id], onDelete: Cascade)
  message      String
  response     String?
  status       String      @default("PENDING")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([submissionId])
  @@index([adminId])
  @@map("clarification_requests")
}

/// User Notifications for submission updates, moderation alerts, and system info
model Notification {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType  @default(SYSTEM)
  title       String
  message     String
  isRead      Boolean           @default(false)
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type])
  @@index([type])
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Gamification Point and XP Transactions awarded for approved submissions and adjustments
model PointTransaction {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation("UserPointTransactions", fields: [userId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission?     @relation("SubmissionPointTransactions", fields: [submissionId], references: [id], onDelete: SetNull)
  points       Int             @default(0)
  xp           Int             @default(0)
  actionType   PointActionType
  description  String
  metadata     Json?
  createdAt    DateTime        @default(now())

  @@index([userId])
  @@index([submissionId])
  @@index([actionType])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([actionType, createdAt(sort: Desc)])
  @@map("point_transactions")
}

/// Dynamic Gamification Level configuration managed by Super Admin
model Level {
  id          String   @id @default(uuid())
  levelNumber Int      @unique
  name        String
  xpRequired  Int      @default(250)
  icon        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([levelNumber])
  @@index([isActive])
  @@map("levels")
}

/// System Audit Log for Super Admin actions and configuration changes
model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  entity    String
  entityId  String?
  details   String
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([actor])
  @@index([action])
  @@index([entity])
  @@index([timestamp(sort: Desc)])
  @@map("audit_logs")
}

/// Gamification Activity XP Rules configured by Super Admin (e.g. LIKE: 1 XP, COMMENT: 2 XP, STORY: 2 XP)
model GamificationSetting {
  id          String   @id @default(uuid())
  activity    String   @unique
  xp          Int      @default(1)
  isActive    Boolean  @default(true)
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([activity])
  @@index([isActive])
  @@map("gamification_settings")
}

/// Transactional Email Log for auditable delivery tracking without storing sensitive secrets
model EmailLog {
  id        String      @id @default(uuid())
  recipient String
  subject   String
  template  String
  status    EmailStatus @default(PENDING)
  messageId String?
  entityId  String?
  error     String?     @db.Text
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([recipient])
  @@index([status])
  @@index([template])
  @@index([entityId])
  @@index([createdAt(sort: Desc)])
  @@map("email_logs")
}

/// Cryptographically hashed single-use short-lived password reset tokens
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

/// User Email Notification Preferences stored in PostgreSQL
model EmailPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  accountSecurity     Boolean  @default(true)
  submissionUpdates   Boolean  @default(true)
  gamificationUpdates Boolean  @default(true)
  announcements       Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_preferences")
}

/// System-wide Email Configuration & Template Customizations managed by Super Admin
model EmailTemplateConfig {
  id           String   @id @default(uuid())
  templateKey  String   @unique
  name         String
  subject      String
  category     String   @default("GENERAL")
  isEnabled    Boolean  @default(true)
  isSecurity   Boolean  @default(false)
  customHeader String?
  customNotes  String?
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([templateKey])
  @@index([category])
  @@map("email_template_configs")
}

/// Global Email Event Toggles configured by Super Admin
model EmailSystemSetting {
  id                  String   @id @default(uuid())
  key                 String   @unique @default("GLOBAL_EVENT_TOGGLES")
  loginNotification   Boolean  @default(true)
  submissionApproval  Boolean  @default(true)
  submissionRejection Boolean  @default(true)
  xpEarned            Boolean  @default(true)
  levelUp             Boolean  @default(true)
  announcements       Boolean  @default(true)
  passwordReset       Boolean  @default(true)
  passwordChanged     Boolean  @default(true)
  accountSecurity     Boolean  @default(true)
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("email_system_settings")
}


PORT=5001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_verification_portal?schema=public
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Transactional Email Configuration (Gmail SMTP / Google App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_FROM="PJ Social Portal" <your_email@gmail.com>

# Optional Gmail OAuth2 Configuration (alternative to App Password)
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_REFRESH_TOKEN=
MAIL_REDIRECT_URI=
